{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "playwright.config.ts",
    "playwright.lockout.config.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "test-data/**/*.ts",
    "scripts/**/*.ts",
    "day-5/performance/**/*.ts",
    "day-4/white-box/**/*.ts"
  ]
}
