{
  "name": "tinubu_surety_qa",
  "version": "1.0.0",
  "description": "Day 1–4 QA planning and Playwright automation for Tinubu Surety Alpha",
  "scripts": {
    "test": "playwright test --grep-invert @lockout",
    "test:full": "npm run test && npm run test:lockout",
    "test:lockout": "playwright test -c playwright.lockout.config.ts --grep @lockout",
    "test:smoke": "playwright test --grep @smoke",
    "test:bond-creation": "playwright test --project=chromium --grep @bond-creation",
    "test:bond-creation:smoke": "playwright test --project=chromium tests/ui/bond-creation/start-bond.spec.ts --grep @smoke",
    "test:regression": "playwright test --grep @regression --grep-invert @lockout",
    "test:sanity": "playwright test --grep @sanity",
    "test:hybrid": "playwright test --grep @hybrid",
    "test:security": "playwright test --grep @security --grep-invert \"@lockout|@stateful-login\"",
    "test:performance": "playwright test --grep @performance",
    "test:usability": "playwright test --grep @usability",
    "test:e2e": "playwright test --grep @e2e",
    "test:high-value": "playwright test --grep @high-value --grep-invert @lockout",
    "test:list": "playwright test --list",
    "test:white-box": "node --experimental-strip-types --experimental-test-coverage --test-coverage-branches=90 --test-coverage-include=day-4/white-box/login-lockout.ts --test-coverage-include=day-4/white-box/bond-quote-validator.ts --test day-4/white-box/login-lockout.unit.test.ts day-4/white-box/bond-quote-validator.unit.test.ts",
    "test:white-box:integration": "node --experimental-strip-types --test day-4/white-box/white-box.integration.test.ts",
    "test:flaky-triage": "node --experimental-strip-types scripts/run-flaky-triage.ts",
    "perf:login": "node --env-file=.env --experimental-strip-types scripts/run-k6.ts day-5/performance/login-5-vus.ts",
    "perf:login-list": "node --env-file=.env --experimental-strip-types scripts/run-k6.ts day-5/performance/login-and-list.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/k6": "^2.2.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.2"
  }
}
